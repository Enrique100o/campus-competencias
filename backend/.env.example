NODE_ENV=development
HOST=127.0.0.1
PORT=3001
MONGODB_URI=mongodb://127.0.0.1:27017/torneos_universidad
CLIENT_ORIGIN=http://127.0.0.1:5173
SESSION_HOURS=8
# Solo habilitado en desarrollo y mientras no exista ninguna cuenta.
ALLOW_INITIAL_SETUP=true
# Renovación automática de sesión. En producción JWT_SECRET debe tener al menos 32 caracteres aleatorios.
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# JWT_SECRET=
